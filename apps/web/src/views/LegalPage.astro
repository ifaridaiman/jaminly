---
// Legal pages (PRD §5.2–5.4, DESIGN §5.10): reading column, "In short" box,
// sticky table of contents on large screens.
import { Icon } from 'astro-icon/components';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { defaultLocale, localeMeta } from '../i18n/config';
import { getLocale, localizedPath, t } from '../i18n/utils';
import type { LegalPage } from '../lib/legal';

interface Props {
  page: LegalPage;
}

const { page } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const strings = t(locale);
const entry = await getEntry('legal', `${locale}/${page}`);
if (!entry) throw new Error(`Missing legal page: src/content/legal/${locale}/${page}.md`);

const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2);
const path = `/${page}`;
const updated = entry.data.updated;
const updatedLabel = new Intl.DateTimeFormat(localeMeta[locale].dateLocale, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(updated);

const pageTitle = entry.data.title.includes('Jaminly') ? entry.data.title : `${entry.data.title} · Jaminly`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: entry.data.title,
  description: entry.data.description,
  inLanguage: locale,
  dateModified: updated.toISOString().slice(0, 10),
  isPartOf: { '@type': 'WebSite', name: 'Jaminly', url: Astro.site?.href },
};
---

<BaseLayout title={pageTitle} description={entry.data.description} path={path} jsonLd={jsonLd}>
  <div
    id="top"
    class="container-page grid gap-12 pb-24 pt-12 md:pt-16 lg:grid-cols-[minmax(0,65ch)_15rem] lg:justify-between"
  >
    <article class="min-w-0">
      <header>
        <h1 class="text-h2 text-balance">{entry.data.title}</h1>
        <p class="mt-3 text-small text-text-secondary">
          {strings.legal.lastUpdated} <time datetime={updated.toISOString().slice(0, 10)}>{updatedLabel}</time>
        </p>
      </header>

      {
        locale !== defaultLocale && (
          <p class="mt-6 flex gap-3 rounded-sm border border-border p-4 text-small text-text-secondary">
            <Icon name="ph:translate" size={20} aria-hidden="true" class="mt-0.5 shrink-0" />
            <span>
              {strings.legal.translationNotice}{' '}
              <a
                href={localizedPath(defaultLocale, path)}
                hreflang={localeMeta[defaultLocale].hreflang}
                class="font-semibold text-primary underline underline-offset-2 hover:text-primary-hover"
              >
                {strings.legal.readEnglish}
              </a>
            </span>
          </p>
        )
      }

      <section aria-labelledby="in-short" class="mt-8 rounded-sm bg-bg-elevated p-5 md:p-6">
        <h2 id="in-short" class="font-semibold">{strings.legal.inShort}</h2>
        <ul class="mt-3 space-y-2">
          {
            entry.data.summary.map((point) => (
              <li class="flex gap-3">
                <Icon name="ph:check-circle" size={20} aria-hidden="true" class="mt-0.5 shrink-0 text-primary" />
                <span>{point}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <div class="legal-prose mt-4">
        <Content />
      </div>

      <p class="mt-16">
        <a
          href="#top"
          class="inline-flex min-h-11 items-center gap-2 text-small font-semibold text-primary hover:text-primary-hover"
        >
          <Icon name="ph:arrow-up" size={16} aria-hidden="true" />
          {strings.legal.backToTop}
        </a>
      </p>
    </article>

    <aside class="hidden lg:block">
      <nav aria-labelledby="toc-title" class="sticky top-24">
        <h2 id="toc-title" class="text-small font-semibold">{strings.legal.onThisPage}</h2>
        <ul class="mt-3 space-y-0.5 border-l border-border">
          {
            toc.map((heading) => (
              <li>
                <a
                  href={`#${heading.slug}`}
                  class="-ml-px block border-l border-transparent py-1.5 pl-4 text-small text-text-secondary transition-colors hover:border-text-secondary hover:text-text"
                >
                  {heading.text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
  </div>
</BaseLayout>
