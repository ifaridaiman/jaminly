---
// Owner-supplied lifestyle photo (DESIGN §6.1). Drop `<slot>.jpg` into src/assets/photos/
// and it is used automatically; until then a labelled placeholder keeps the exact size.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getLocale, t } from '../i18n/utils';
import { photoSlots, type PhotoSlotName } from '../lib/photos';

interface Props {
  name: PhotoSlotName;
  alt: string;
  sizes: string;
  class?: string;
}

const { name, alt, sizes, class: className } = Astro.props;
const { width, height } = photoSlots[name];
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const photo = Object.entries(photos).find(([path]) => path.split('/').pop()!.replace(/\.\w+$/, '') === name)?.[1]
  .default;

if (!photo) console.warn(`[photos] Missing src/assets/photos/${name}.jpg (${width}×${height}); showing a placeholder.`);

const strings = t(getLocale(Astro.currentLocale));
---

{
  photo ? (
    <Picture
      src={photo}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[640, 1024, 1600, Math.min(2400, photo.width)]}
      sizes={sizes}
      class:list={['h-auto w-full rounded-lg object-cover', className]}
      style={`aspect-ratio: ${width} / ${height}`}
    />
  ) : (
    <div
      role="img"
      aria-label={alt}
      class:list={[
        'flex w-full flex-col items-center justify-center gap-2 rounded-lg border border-dashed border-border bg-bg-elevated p-6 text-center text-small text-text-secondary',
        className,
      ]}
      style={`aspect-ratio: ${width} / ${height}`}
      data-photo-placeholder={name}
    >
      <Icon name="ph:image" size={28} aria-hidden="true" />
      <span aria-hidden="true">
        {strings.photoSlot.label}: {name}.jpg · {width}×{height}
      </span>
    </div>
  )
}
