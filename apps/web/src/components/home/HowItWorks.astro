---
// HOME-4 (DESIGN §5.5): sticky heading on the left, three steps with screenshots on the right.
import Screenshot from '../Screenshot.astro';
import { getLocale, t } from '../../i18n/utils';
import { screens } from '../../lib/screens';

const strings = t(getLocale(Astro.currentLocale));
const how = strings.how;
const steps = [
  { ...how.snap, screen: screens.addReceipt },
  { ...how.set, screen: screens.addCoverage },
  { ...how.remind, screen: screens.detail },
];
---

<section class="container-page grid gap-12 py-20 md:py-28 lg:grid-cols-12 lg:gap-8">
  <div class="lg:col-span-4">
    <h2 class="text-h2 text-balance lg:sticky lg:top-28">{how.title}</h2>
  </div>

  <ol class="grid gap-16 md:gap-20 lg:col-span-8 lg:col-start-5">
    {
      steps.map((step) => (
        <li class="reveal grid items-center gap-8 sm:grid-cols-[minmax(0,1fr)_14rem] md:gap-12">
          <div>
            <h3 class="text-h3">{step.title}</h3>
            <p class="mt-3 max-w-[40ch] text-lead text-text-secondary">{step.body}</p>
          </div>
          <div class="shot mx-auto w-[70%] max-w-[16rem] sm:w-full">
            <Screenshot
              {...step.screen}
              alt={step.alt}
              widths={[240, 480, 780]}
              sizes="(min-width: 640px) 224px, 70vw"
              class="block h-auto w-full"
            />
          </div>
        </li>
      ))
    }
  </ol>
</section>
