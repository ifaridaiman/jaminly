---
// HOME-3 (DESIGN §5.4): five features, five bento cells in rows of 7/5, 5/7 and 12,
// so no row is three equal cards (taste §9.C).
import { Icon } from 'astro-icon/components';
import Screenshot from '../Screenshot.astro';
import { getLocale, t } from '../../i18n/utils';
import { screens } from '../../lib/screens';
import { anchors } from '../../lib/site';

const strings = t(getLocale(Astro.currentLocale));
const f = strings.features;
const cell = 'reveal flex flex-col overflow-hidden rounded-lg p-6 md:p-8';
---

<section id={anchors.features} class="container-page py-20 md:py-28">
  <p class="eyebrow">{f.eyebrow}</p>
  <h2 class="mt-3 max-w-[22ch] text-h2 text-balance">{f.title}</h2>

  <div class="mt-12 grid gap-4 lg:grid-cols-12">
    <article class:list={[cell, 'bg-bg-elevated lg:col-span-7']}>
      <Icon name="ph:receipt" size={28} aria-hidden="true" class="text-primary" />
      <h3 class="mt-4 text-h3">{f.vault.title}</h3>
      <p class="mt-2 max-w-[40ch] text-text-secondary">{f.vault.body}</p>
      <div class="shot mx-auto mt-8 w-full max-w-[24rem]">
        <Screenshot
          {...screens.cropVault}
          alt={f.vault.alt}
          widths={[360, 560, 780]}
          sizes="(min-width: 640px) 384px, calc(100vw - 5rem)"
          class="block h-auto w-full"
        />
      </div>
    </article>

    <article class:list={[cell, 'bg-bg-elevated lg:col-span-5']}>
      <Icon name="ph:bell-ringing" size={28} aria-hidden="true" class="text-primary" />
      <h3 class="mt-4 text-h3">{f.reminders.title}</h3>
      <p class="mt-2 text-text-secondary">{f.reminders.body}</p>
      <div class="mt-6 overflow-hidden rounded-md border border-border">
        <Screenshot
          {...screens.cropStatus}
          alt={f.reminders.alt}
          widths={[360, 560, 780]}
          sizes="(min-width: 1024px) 380px, calc(100vw - 5rem)"
          class="block h-auto w-full"
        />
      </div>
    </article>

    <article class:list={[cell, 'bg-bg-elevated lg:col-span-5']}>
      <Icon name="ph:shield-check" size={28} aria-hidden="true" class="text-primary" />
      <h3 class="mt-4 text-h3">{f.coverage.title}</h3>
      <p class="mt-2 text-text-secondary">{f.coverage.body}</p>
      <div class="mt-6 overflow-hidden rounded-md border border-border">
        <Screenshot
          {...screens.cropCoverage}
          alt={f.coverage.alt}
          widths={[360, 560, 780]}
          sizes="(min-width: 1024px) 380px, calc(100vw - 5rem)"
          class="block h-auto w-full"
        />
      </div>
    </article>

    <article class:list={[cell, 'bg-bg-elevated lg:col-span-7']}>
      <Icon name="ph:devices" size={28} aria-hidden="true" class="text-primary" />
      <h3 class="mt-4 text-h3">{f.sync.title}</h3>
      <p class="mt-2 max-w-[44ch] text-text-secondary">{f.sync.body}</p>
      <div class="mt-6 aspect-[16/8] overflow-hidden rounded-md border border-border">
        <Screenshot
          {...screens.webHome}
          alt={f.sync.alt}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1200px) 610px, calc(100vw - 5rem)"
          class="block h-full w-full object-cover object-top"
        />
      </div>
    </article>

    <article class:list={[cell, 'bg-primary-soft lg:col-span-12 lg:grid lg:grid-cols-12 lg:items-center lg:gap-8']}>
      <div class="lg:col-span-5">
        <Icon name="ph:hand-heart" size={28} aria-hidden="true" class="text-primary" />
        <h3 class="mt-4 text-h3">{f.openSource.title}</h3>
      </div>
      <p class="mt-2 text-lead text-text-secondary lg:col-span-7 lg:mt-0">{f.openSource.body}</p>
    </article>
  </div>
</section>
