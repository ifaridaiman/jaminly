# Copy to .env. Defaults match docker-compose.yml.
PORT=3001
DATABASE_URL=postgresql://jaminly:jaminly@localhost:5432/jaminly

# openssl rand -base64 32
JWT_SECRET=change-me

# Optional. Comma-separated Google OAuth client IDs (Web, iOS, Android) for "Continue with Google".
# Empty = Google sign-in off; email/password still works.
GOOGLE_CLIENT_IDS=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jaminly-receipts
S3_ACCESS_KEY_ID=jaminly
S3_SECRET_ACCESS_KEY=jaminly-dev-secret
# Address devices use for presigned upload/download URLs. Empty = S3_ENDPOINT.
# On a physical phone in dev: http://<your LAN IP>:9000
S3_PUBLIC_ENDPOINT=

# MailHog; view sent mail at http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Jaminly <no-reply@jaminly.app>

WEB_APP_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081

# Empty = no limit
USER_WARRANTY_LIMIT=
USER_STORAGE_LIMIT_MB=

# expo | log  (log prints pushes instead of sending)
PUSH_PROVIDER=expo
# Only if "Enhanced push security" is on for the Expo project
EXPO_ACCESS_TOKEN=

# Swagger UI at /docs is on outside production; set true to force it on
SWAGGER=

# true only behind a gateway that sets x-request-id; otherwise the API generates its own
TRUST_REQUEST_ID=
