# Shared, non-secret build flags (committed). Put secrets and personal overrides in .env.local (git-ignored).

# Show modal routes (warranty view/add/edit) as a pop-up on web instead of a full page.
# Unstable Expo Router feature: restart `expo start` after changing it.
EXPO_UNSTABLE_WEB_MODAL=1

# The Jaminly API (apps/warranty-api, `pnpm dev` at the repo root). Sign-in and account calls always use it.
# On a physical phone use your machine's LAN IP instead of localhost (override in .env.local).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Google Web client ID. Empty hides "Continue with Google".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
